@echo off
setlocal
title Transcritor - PowerShell 7 Administrador
set "TRANSCRISTO_DIR=%~dp0"
set "TRANSCRISTO_"
set "TRANSCRISTO_"
set "TRANSCRISTO_"

powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "try { $root=$env:TRANSCRISTO_DIR; $candidates=@('C:\Program Files\WindowsApps\Microsoft.PowerShell_7.6.9.0_x64__8wekyb3d8bbwe\pwsh.exe',(Join-Path $env:ProgramFiles 'PowerShell\7\pwsh.exe'),(Join-Path $env:LOCALAPPDATA 'Microsoft\PowerShell\7\pwsh.exe'),(Join-Path $env:LOCALAPPDATA 'Microsoft\WindowsApps\pwsh.exe')); $pwsh=$candidates | Where-Object { Test-Path -LiteralPath $_ -PathType Leaf } | Select-Object -First 1; if (-not $pwsh) { throw 'PowerShell 7 nao encontrado. Instale-o antes de abrir o programa.' }; $q=[string][char]39; $menu=[Text.Encoding]::Unicode.GetString([Convert]::FromBase64String($env:TRANSCRISTO_MENU1+$env:TRANSCRISTO_MENU2+$env:TRANSCRISTO_MENU3)); $command='Set-Location -LiteralPath '+$q+$root.Replace($q,$q+$q)+$q+'; '+$menu; $encoded=[Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($command)); if ($env:TRANSCRISTO_TEST -eq '1') { $errors=$null; [System.Management.Automation.Language.Parser]::ParseInput($command,[ref]$null,[ref]$errors) | Out-Null; if ($errors.Count) { throw ($errors | Out-String) }; Write-Host 'OK: menu e lancador validados; nenhuma janela aberta'; exit 0 }; Start-Process -FilePath $pwsh -Verb RunAs -WindowStyle Normal -WorkingDirectory $root -ArgumentList @('-NoLogo','-NoExit','-ExecutionPolicy','Bypass','-EncodedCommand',$encoded) -ErrorAction Stop; exit 0 } catch { Write-Host ('Nao foi possivel abrir: '+$_.Exception.Message); exit 1 }"

if errorlevel 1 (
    pause
    exit /b 1
)
exit /b 0
